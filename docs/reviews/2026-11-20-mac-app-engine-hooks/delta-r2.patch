+_HELD_ENGINE = """
+import sys, subprocess, time
+from anyscribe.web import app as web_app
+
+web_app.STDIN_EXIT_GRACE_SECONDS = 0.5
+web_app._lead_own_process_group()  # what run() does with --watch-stdin
+child = subprocess.Popen(["sleep", "300"])
+print(child.pid, flush=True)
+
+class Server:
+    should_exit = False  # a server that never finishes stopping (a job holding it)
+
+class Share:
+    port = 0
+    def close(self):
+        return None
+
+web_app._stop_when_stdin_closes(Server(), Share())
+time.sleep(300)
+"""
+
+
+def _alive(pid: int) -> bool:
+    stat = subprocess.run(["ps", "-o", "stat=", "-p", str(pid)], capture_output=True, text=True)
+    return stat.stdout.strip() not in ("", "Z")  # gone, or a zombie waiting to be reaped
+
+
+@pytest.mark.skipif(not hasattr(os, "killpg"), reason="process groups are POSIX only")
+def test_the_hard_exit_takes_the_engines_children_with_it():
+    """A real engine process, held up so the hard exit fires, with a real child (`sleep 300`,
+    standing in for pip, yt-dlp or ffmpeg): after the deadline both are gone."""
+    proc = subprocess.Popen(
+        [sys.executable, "-c", _HELD_ENGINE],
+        stdin=subprocess.PIPE,
+        stdout=subprocess.PIPE,
+        text=True,
+    )
+    child = int(proc.stdout.readline())
+    try:
+        assert _alive(child)
+        proc.stdin.close()
+        proc.wait(timeout=10)
+        deadline = time.monotonic() + 5
+        while _alive(child) and time.monotonic() < deadline:
+            time.sleep(0.1)
+        assert not _alive(child), "the engine's child outlived its hard exit"
+    finally:
+        if proc.poll() is None:  # stop exactly the processes this test started
+            proc.kill()
+        if _alive(child):
+            os.kill(child, 9)
+
+
+_APP_HOLDING_AN_ENGINE = """
+import subprocess, sys, time
+# This process stands in for the app; the engine below did not make itself a group leader.
+engine = subprocess.run(
+    [sys.executable, "-c", "from anyscribe.web import app; app._exit_hard()"]
+)
+print("app survived", engine.returncode, flush=True)
+"""
+
+
+@pytest.mark.skipif(not hasattr(os, "killpg"), reason="process groups are POSIX only")
+def test_the_hard_exit_never_signals_a_group_the_engine_does_not_lead():
+    """An engine in the app's group (no group of its own) exits alone; the app lives on.
+    Runs in a new session so even a wrong group kill cannot reach pytest."""
+    done = subprocess.run(
+        [sys.executable, "-c", _APP_HOLDING_AN_ENGINE],
+        capture_output=True,
+        text=True,
+        timeout=60,
+        start_new_session=True,
+    )
+    assert done.stdout.strip() == "app survived 1", (done.returncode, done.stderr)
